# Database Configuration
# Local development uses file:./dev.db (SQLite).
# On Vercel serverless, the runtime automatically initializes a writable SQLite
# database at file:/tmp/dentalcare.db and hydrates/persists via Google Sheets.
DATABASE_URL="file:./dev.db"

# Authentication & Session Security
AUTH_USERNAME="doctorkinjal"
# Generate a 60-character bcrypt hash for your clinic password.
# In local .env files, escape $ as \$ inside double quotes. In Vercel Environment Variables, paste the unescaped $2b$12$... hash.
AUTH_PASSWORD_HASH=""
# Required in production: at least 32 random characters for signing HTTP-only JWT session cookies.
AUTH_SECRET="replace-with-a-random-32-byte-secret-in-production"

# Google Sheets Synchronization & Serverless Persistence
GOOGLE_SHEET_ID="your-google-spreadsheet-id"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
